<div class="embed-responsive embed-responsive-16by9">
	<iframe width="560"
			height="315"
			class="embed-responsive-item"
			src="@GetURL()"
		allowfullscreen></iframe>

</div>
@code {
	[Parameter]
	public string VideoCode { get; set; }

	public string GetURL()
	{
		return $"https://www.youtube.com/embed/" + VideoCode;
	}
}
