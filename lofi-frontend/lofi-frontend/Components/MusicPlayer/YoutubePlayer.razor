@inject IJSRuntime JS

<div id="yt-player" class="w-100 h-100"></div>

@code {
	[Parameter]
	public string VideoCode { get; set; } = "ZvJQt559CTY";

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (firstRender)
		{
			await Task.Delay(500);
			await JS.InvokeVoidAsync("initializeYouTubePlayer", "yt-player", VideoCode);
		}	
	}

	public async Task Play() => await JS.InvokeVoidAsync("playYouTubeVideo");
	public async Task Pause() => await JS.InvokeVoidAsync("stopYouTubeVideo");
	public async Task ResetTime() => await JS.InvokeVoidAsync("resetSeeker");
}
