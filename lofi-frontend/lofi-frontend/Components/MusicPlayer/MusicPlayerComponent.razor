@using lofi_frontend.Components.Pages.Search

<div class="home-card no-border d-flex flex-column gap-3">

	<div class="card-img justify-content-center">
		<div class="col-xl-10 col-xxl-8">
			<div class="ratio ratio-16x9 rounded-3 overflow-hidden shadow">
				<YoutubePlayer @ref="PlayerReference" VideoCode="@VideoCode" />
			</div>
		</div>
	</div>

	@* Control/Search Container *@
	<div class="control-container d-flex flex-row gap-4 justify-content-between align-items-center">

		@* Timer Component *@
		<div class="d-flex flex-column gap-2 justify-content-center align-items-center">
			<div class="d-flex flex-row align-items-center gap-2">
				<div class="ms-5">
					<TaskTimerComponent @ref="TimerReference" />
				</div>

				<button class="btn p-0" @onclick="ResetTimer">
					<img src="images/reset.png" height="50" />
				</button>
			</div>

			@* Timer Buttons *@
			<div class="d-flex flex-row gap-2 justify-content-center">
				@if (!IsPlaying)
				{
					<button class="btn btn-success btn-lg px-4 shadow-sm"
							@onclick="StartTimerAndVideo">
						<img src="images/play.png" style="filter: invert(1) brightness(2);" height="30" />
					</button>
				}
				else
				{
					<button class="btn btn-danger btn-lg px-4 shadow-sm"
							@onclick="PauseTimerAndVideo">
						<img src="images/pause.png" style="filter: invert(1) brightness(2);" height="30" />
					</button>
				}
				<button class="btn btn-dark btn-lg px-4" @onclick="ResetVideo">
					<img src="images/reset.png" style="filter: invert(1) brightness(2);" height="30" />
				</button>

				<button class="btn btn-dark btn-lg px-4 shadow-sm d-flex align-items-center gap-2"
						@onclick="SaveTask">
					Save Task
				</button>
			</div>
		</div>
		@* Search Field *@
		<SearchField GetSearchTerm="GetSearchTerm"/>
	</div>
</div>


@code {
	[Parameter]
	public string VideoCode { get; set; } = "ZvJQt559CTY";

	[Parameter] 
	public EventCallback<string> GetSearchTerm { get; set; }

	private YoutubePlayer? PlayerReference { get; set; }
	private TaskTimerComponent? TimerReference { get; set; }

	private bool IsPlaying = false;

	private async Task StartTimerAndVideo()
	{
		IsPlaying = true;

		if (PlayerReference != null && TimerReference != null)
		{
			await PlayerReference.Play();
			await TimerReference.StartTimer();
		}
	}

	private async Task PauseTimerAndVideo()
	{
		IsPlaying = false;
		if (PlayerReference != null && TimerReference != null)
		{
			await PlayerReference.Pause();
			await TimerReference.StopTimer();
		}
	}

	private async Task ResetTimer()
	{
		if (TimerReference != null)
		{
			await TimerReference.Dispose();
		}
	}

	private async Task ResetVideo()
	{
		if (PlayerReference != null)
		{
			await PlayerReference.ResetTime();
		}
	}

	private async Task SaveTask()
	{
		Console.WriteLine("Attempting to save task");
		if (PlayerReference == null && TimerReference == null) return;

		Console.WriteLine("Checking if playing ");
		if (IsPlaying) return;

		Console.WriteLine("Saving Task to DB");
		await TimerReference.SaveTaskTime();
	}
}
