@using System.Reflection.Metadata
@using lofi_frontend.Models
@using lofi_frontend.Models.Enum
@page "/Signup"
@rendermode InteractiveServer
@inject NavigationManager NavigationManager;
@inject HttpClient httpClient;
@using System.Text;


<div class="signup-title-text">
    <h1>Create your account</h1>

</div>

<div class="Signup-Form-Box">

    <EditForm Model="user" OnValidSubmit="HandleSignup" FormName="SignupForm" class="form-container">
        <DataAnnotationsValidator />
        <div class="Form-Group">
            <label for="firstname-input">First Name</label>
            <InputText id="firstname-input" @bind-Value="user.FirstName" class="input-group" />
            <ValidationMessage For="@(() => user.FirstName)" />
        </div>
        <div class="Form-Group">
            <label for="lastname-input">Last Name</label>
            <InputText id="lastname-input" @bind-Value="user.LastName" class="input-group" />
            <ValidationMessage For="@(() => user.LastName)" />
        </div>
        <div class="Form-Group">
            <label for="email-input">Email</label>
            <InputText id="email-input" @bind-Value="user.Email" class="input-group" />
            <ValidationMessage For="@(() => user.Email)" />
        </div>
        <div class="Form-Group">
            <label for="username-input">UserName</label>
            <InputText id="username-input" @bind-Value="user.Username" class="input-group" />
            <ValidationMessage For="@(() => user.Username)" />
        </div>
        <div class="Form-Group">
            <label for="password-input">Password</label>
            <InputText id="password-input" type="@(ShowPassword ? "text" : "password")" @bind-Value="user.Password" class="input-group" />
            <ValidationMessage For="@(() => user.Password)" />
        </div>
        <div>
            <input type="checkbox" @bind="ShowPassword"/>
            <label for="showPassword">Show Password</label>
        </div>

        <div class="Form-Group">
            <label for="Date-of-birth">Date of Birth</label>
            <InputDate id="Date-of-birth" @bind-Value="user.DOB" class="input-group" />
            <ValidationMessage For="@(() => user.DOB)" />
        </div>
        <div class="Form-Group row">
            <label for="gender">Gender</label>
            <InputSelect @bind-Value="user.Gender" class="input-group" >
            @foreach (var gender in Enum.GetValues(typeof(Gender)))
            {
                <option value="@gender">@gender</option>
               
            }
            </InputSelect>
        </div>

            <button class="Signup-Button" type="submit" >Sign Up</button>
            <h4>Already have an account?</h4>
        <NavLink href="@($"/Login")">
            <button class="Account-Button" type="button">Log in</button>
        </NavLink>
        @* <div class="g-signin2" data-onsuccess="onSignIn"></div> *@

    </EditForm>
</div>


@code {

    [SupplyParameterFromForm]
    public User user { get; set; } = new User();

    private User createdUser { get; set; } = new User();
    private bool ShowPassword { get; set; } = false;


    private void checkSignUp()
    {
        Console.WriteLine($"{user.FirstName} ,{user.LastName},{user.Email},{user.Username},{user.Password},{user.DOB},{user.Gender}");
    

    }

    private async Task HandleSignup()
    {

        // if (user.DOB != null)
        // {
        //     var age = DateTime.Today.Year - user.DOB.Value.Year;
        //     if (user.DOB > DateTime.Today.AddYears(-age))
        //         age--;

        //     if (age < 13)
        //     {
        //         EditContext.AddValidationMessage(() => user.DOB, "You must be at least 13.");
        //         return;
        //     }
        // }

        try
        {
            var response = await httpClient.PostAsJsonAsync(($"/{user.Id}"), createdUser);

            if(response.IsSuccessStatusCode)
            {
                var newUser = await response.Content.ReadFromJsonAsync<User>();

                NavigationManager.NavigateTo($"/UserDashboard/{createdUser.Id}");
            }
            else
            {
                Console.WriteLine("User creation failed. Do you already have an account?");
            }

        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error creating user: {ex.Message}");
        }
  
    }

}
