@using System.Reflection.Metadata
@using lofi_frontend.Models
@using lofi_frontend.Models.Enum
@page "/Signup"
@rendermode InteractiveServer
@inject NavigationManager NavigationManager;
@inject HttpClient httpClient;
@using System.Text;

<div class="container-fluid d-flex justify-content-center align-items-start bg-info min-vh-100">
    <div class="card p-4 shadow my-5" style="width: 100%; max-width: 500px;">
        
        <h1 class="text-center h3 mb-4">Create your account</h1>

        <EditForm 
            EditContext="editContext"
            OnValidSubmit="HandleSignup" 
            FormName="SignupForm">
            
            <DataAnnotationsValidator />

            <div class="mb-3">
                <label for="firstname-input" class="form-label">First Name</label>
                <InputText id="firstname-input" class="form-control" @bind-Value="user.FirstName" />
                <div class="text-danger small"><ValidationMessage For="@(() => user.FirstName)" /></div>
            </div>

            <div class="mb-3">
                <label for="lastname-input" class="form-label">Last Name</label>
                <InputText id="lastname-input" class="form-control" @bind-Value="user.LastName" />
                <div class="text-danger small"><ValidationMessage For="@(() => user.LastName)" /></div>
            </div>

            <div class="mb-3">
                <label for="email-input" class="form-label">Email address</label>
                <InputText id="email-input" type="email" class="form-control" @bind-Value="user.Email" />
                <div class="text-danger small"><ValidationMessage For="@(() => user.Email)" /></div>
            </div>

            <div class="mb-3">
                <label for="username-input" class="form-label">Username</label>
                <InputText id="username-input" class="form-control" @bind-Value="user.Username" />
                <div class="text-danger small"><ValidationMessage For="@(() => user.Username)" /></div>
            </div>

            <div class="mb-2">
                <label for="password-input" class="form-label">Password</label>
                <InputText id="password-input" type="@(ShowPassword ? "text" : "password")" class="form-control" @bind-Value="user.Password" />
                <div class="text-danger small"><ValidationMessage For="@(() => user.Password)" /></div>
            </div>

            <div class="mb-3 form-check">
                <input type="checkbox" class="form-check-input" id="showPassword" @bind="ShowPassword" />
                <label class="form-check-label" for="showPassword">Show Password</label>
            </div>

            <div class="mb-3">
                <label for="Date-of-birth" class="form-label">Date of Birth</label>
                <InputDate id="Date-of-birth" class="form-control" @bind-Value="user.DOB" />
                <div class="text-danger small"><ValidationMessage For="@(() => user.DOB)" /></div>
            </div>

            <div class="mb-4">
                <label for="gender" class="form-label">Gender</label>
                <InputSelect id="gender" class="form-select" @bind-Value="user.Gender">
                    @foreach (var gender in Enum.GetValues(typeof(Gender)))
                    {
                        <option value="@gender">
                            @switch (gender)
                            {
                                case Gender.NonBinary:
                                    @("Non-Binary")
                                    break;
                                case Gender.PreferNotToSay:
                                    @("Prefer Not To Say")
                                    break;
                                default:
                                    @gender.ToString()
                                    break;
                            }
                        </option>
                    }
                </InputSelect>
            </div>

            <button class="btn btn-primary w-100 mb-3" type="submit">Sign Up</button>
            
            <hr />

            <div class="text-center">
                <p class="mb-2 text-muted">Already have an account?</p>
                <NavLink href="Login" class="btn btn-outline-secondary w-100">
                    Log in
                </NavLink>
            </div>

        </EditForm>
    </div>
</div>

@code {
	[SupplyParameterFromForm]
	public User user { get; set; } = new User();

	private bool ShowPassword { get; set; } = false;
	private EditContext? editContext;
	private ValidationMessageStore? validationMessageStore;

	protected override void OnInitialized()
	{
		user ??= new();
		editContext = new EditContext(user);
		editContext.OnValidationRequested += HandleValidationRequested;
		validationMessageStore = new ValidationMessageStore(editContext);
	}

	private void HandleValidationRequested(object? sender, ValidationRequestedEventArgs e)
	{
		validationMessageStore?.Clear();

		if (user.DOB != default)
		{
			var age = DateTime.Today.Year - user.DOB.Year;
			if (user.DOB > DateTime.Today.AddYears(-age))
				age--;

			if (age < 13)
			{
				validationMessageStore?.Add(() => user.DOB, "You must be at least 13 years old.");
			}
		}

		editContext?.NotifyValidationStateChanged();
	}

	private async Task HandleSignup()
	{
		try
		{
			var response = await httpClient.PostAsJsonAsync($"/{user.Id}", user);

			if (response.IsSuccessStatusCode)
			{
				var newUser = await response.Content.ReadFromJsonAsync<User>();

				NavigationManager.NavigateTo($"/UserDashboard/{user.Id}");
			}
			else
			{
				Console.WriteLine("User creation failed. Do you already have an account?");
			}
		}
		catch (Exception ex)
		{
			Console.WriteLine($"Error creating user: {ex.Message}");
		}
	}

	public void Dispose()
	{
		if (editContext != null)
		{
			editContext.OnValidationRequested -= HandleValidationRequested;
		}
	}
}
