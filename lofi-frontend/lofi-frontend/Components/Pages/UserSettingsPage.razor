@using lofi_frontend.Models
@page "/Settings"
@rendermode InteractiveServer

<div class="dashboard-layout">
<div class="sidebar">
        <div class="sidebar-buttons">
        <button class="changePassword-button" type="button" @onclick="ChangePassword">Change Password</button>
        <button class="Details-button" type="button" @onclick="UpdateDetails">Update Details</button>
            <button class="Contact-Support-button" type="button" @onclick="ContactSupport">Contact Support</button>

        <button class="Delete-Account-button" type="button" @onclick="DeleteAccount">Delete Account</button>
 </div>
 </div>

 <div class="content">

        @if (selectedSection == "")
        {
            <h3 class="text-center h4 mb-4">Settings</h3>

            <div class="container-fluid d-flex justify-content-center align-items-start bg-info min-vh-100">
                <div class="card p-4 shadow mt-5" style="width: 100%; max-width: 450px;">

                    <h4 class="text-center h4 mb-4">Change Password</h4>


                    <EditForm Model="userSettings" OnValidSubmit="UpdateUserSettings" FormName="UserSettingsForm">
                        <DataAnnotationsValidator />

                        <div class="mb-3">
                            <label class="form-label">New Password</label>
                            <InputText @bind-Value="userSettings.NewPassword" class="form-control" />
                            <div class="text-danger small"><ValidationMessage For="@(() => userSettings.NewPassword)" /></div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Repeat Password</label>
                            <InputText @bind-Value="userSettings.ConfirmNewPassword" class="form-control" />
                            <div class="text-danger small"><ValidationMessage For="@(() => userSettings.ConfirmNewPassword)" /></div>
                        </div>
                        <button class="btn btn-primary" type="submit">Submit</button>

                    </EditForm>

                </div>
            </div>
        }
        @if (selectedSection == "ChangePassword")
    {
        <UpdatePassword/>
    }
    @if(selectedSection == "UpdateDetails")
    {
        <UpdateDetails/>

    }
        @if (selectedSection == "ContactSupport")
    {
        <ContactSupport/>
    }
    @if(selectedSection == "DeleteAccount")
    {
        <DeleteAccount/>
    }

</div>
</div>





@code {

    private UserSettingsForm userSettings = new UserSettingsForm();
    private string errorMessage = string.Empty;
    private string selectedSection = "";


    private void ChangePassword()
    {
        selectedSection = "ChangePassword";


    }

    private void UpdateDetails()
    {
        selectedSection = "UpdateDetails";

    }
    private void ContactSupport()
    {
        selectedSection = "ContactSupport";
    }

    private void DeleteAccount()
    {
        selectedSection = "DeleteAccount";
    }

    private async Task UpdateUserSettings()
    {


        return;
    }

}



  