@using lofi_frontend.Models

@inject HttpClient httpClient;


    <div class="card p-4 shadow mt-5" style="width: 100%; max-width: 450px;">

        <h4 class="text-center h4 mb-4">Change Password</h4>

        @if (!string.IsNullOrEmpty(successMessage))
        {
            <div class="alert alert-success">
                @successMessage
            </div>
        }

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger">
                @errorMessage
            </div>
        }


        <EditForm Model="userSettings" OnValidSubmit="UpdateUserSettings" FormName="UserSettingsForm">
            <DataAnnotationsValidator />
            <ValidationSummary/>
            <div class="mb-3">
                <label class="form-label">New Password</label>
                <InputText @bind-Value="userSettings.NewPassword" class="form-control" />
                <div class="text-danger small"><ValidationMessage For="@(() => userSettings.NewPassword)" /></div>
            </div>

            <div class="mb-3">
                <label class="form-label">Repeat Password</label>
                <InputText @bind-Value="userSettings.ConfirmNewPassword" class="form-control" />
                <div class="text-danger small"><ValidationMessage For="@(() => userSettings.ConfirmNewPassword)" /></div>
            </div>
            <p class="small text-muted">Please ensure your password is at least 8 characters long and includes a special character</p>
            <button class="btn btn-primary" type="submit" disabled="@isUpdating">
                @(isUpdating ? "Updating..." : "Submit")>
            </button>

        </EditForm>

    </div>

@code {
    [Parameter] public int Id { get; set; }

    private UserSettingsForm userSettings = new UserSettingsForm();
    private string errorMessage = string.Empty;
    private string successMessage = string.Empty;
    private bool isUpdating = false;


    private async Task UpdateUserSettings()
    {
        isUpdating = true;  
        successMessage = string.Empty;
        errorMessage = string.Empty;
        try
        {
            var currentUser = await httpClient.GetFromJsonAsync<UserWithPassword>($"/Users/{Id}");

            if(currentUser == null)
            {
                errorMessage = "User not found.";
                return;
            }

            currentUser.Password = userSettings.NewPassword;


            var response = await httpClient.PutAsJsonAsync($"/Users/{Id}", currentUser);

            if (response.IsSuccessStatusCode)
            {
                successMessage = "Password updated successfully.";

                userSettings = new UserSettingsForm();
            }
            else
            {
                errorMessage = "Failed to update password.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"An error occurred: {ex.Message}";
        }
        finally
        {
            isUpdating = false;
        }
    }

}
