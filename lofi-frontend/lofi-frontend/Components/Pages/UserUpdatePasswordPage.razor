@using lofi_frontend.Models

@inject HttpClient httpClient;


<div class="reset-page-wrapper">
    <div class="card reset-password-card shadow">

        <h3 class="text-center reset-heading">Change Password 🔑</h3>

        @if (!string.IsNullOrEmpty(successMessage))
        {
            <div class="alert alert-success custom-alert">
                @successMessage
            </div>
        }

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger custom-alert">
                @errorMessage
            </div>
        }

        <EditForm Model="userSettings" OnValidSubmit="UpdateUserSettings" FormName="UserSettingsForm">
            <DataAnnotationsValidator />

            <div class="mb-4">
                <label class="form-label custom-label">New Password</label>
                <InputText type="password" @bind-Value="userSettings.NewPassword" class="form-control custom-input" placeholder="••••••••" />
                <div class="text-danger small mt-1"><ValidationMessage For="@(() => userSettings.NewPassword)" /></div>
            </div>

            <div class="mb-3">
                <label class="form-label custom-label">Repeat Password</label>
                <InputText type="password" @bind-Value="userSettings.ConfirmNewPassword" class="form-control custom-input" placeholder="••••••••" />
                <div class="text-danger small mt-1"><ValidationMessage For="@(() => userSettings.ConfirmNewPassword)" /></div>
            </div>

            <p class="password-hint">💡 Please ensure your password is at least 8 characters long and includes a special character.</p>

            <button class="btn btn-primary w-100 reset-submit-btn" type="submit" disabled="@isUpdating">
                @(isUpdating ? "Updating..." : "Submit Changes")
            </button>
        </EditForm>
    </div>
</div>

@code {
    [Parameter] public int Id { get; set; }

    private UserSettingsForm userSettings = new UserSettingsForm();
    private string errorMessage = string.Empty;
    private string successMessage = string.Empty;
    private bool isUpdating = false;


    private async Task UpdateUserSettings()
    {
        isUpdating = true;  
        successMessage = string.Empty;
        errorMessage = string.Empty;
        try
        {
            var payload = new { NewPassword = userSettings.NewPassword};

            var response = await httpClient.PutAsJsonAsync("/Auth/update-password", payload);

            if(response.IsSuccessStatusCode)
            {
                successMessage = "Password updated successfully!";
                userSettings = new UserSettingsForm();
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                errorMessage = $"Failed to update password: {errorContent}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"An error occurred: {ex.Message}";
        }
        finally
        {
            isUpdating = false;
        }
    }

}
