@using lofi_frontend.Models
@using lofi_frontend.Models.Enum

<div class="container-fluid d-flex justify-content-center align-items-start min-vh-100">
    <div class="card p-4 shadow" style="width: 100%; max-width: 600px;">
        
        <h2>We are here to help</h2>
        <p>Please fill out the form below and our support team will get back to you as soon as possible.</p>
        
        <EditForm Model="@supportMessage" OnValidSubmit="HandleSendMessage" FormName="ContactSupportForm">
            <DataAnnotationsValidator />

            <div class="mb-3">
                <label for="name-input" class="form-label">Name</label>
                <InputText id="name-input" @bind-Value="supportMessage.Name" class="form-control" />
                <ValidationMessage For="@(() => supportMessage.Name)" />
            </div>

            <div class="mb-3">
                <label for="email-input" class="form-label">Email</label>
                <InputText id="email-input" @bind-Value="supportMessage.Email" class="form-control" />
                <ValidationMessage For="@(() => supportMessage.Email)" />
            </div>

            <div class="mb-3">
                <label for="countryCode" class="form-label">Country Code</label>
                <div class="phone-input-group">
                    <InputSelect id="countryCode" class="form-select country-select-box" @bind-Value="supportMessage.SelectedCountry">
                        @foreach (var country in Enum.GetValues(typeof(CountryCode)))
                        {
                            <option value="@country">
                                @switch (country)
                                {
                                    case CountryCode.US:
                                        @:United States (+1)
                                        break;
                                    case CountryCode.UK:
                                        @:United Kingdom (+44)
                                        break;
                                    case CountryCode.Australia:
                                        @:Australia (+61)
                                        break;
                                    case CountryCode.Germany:
                                        @:Germany (+49)
                                        break;
                                    case CountryCode.Canada:
                                        @:Canada (+1)
                                        break;
                                    case CountryCode.India:
                                        @:India (+91)
                                        break;
                                    default:
                                        @:Unknown
                                        break;
                                }
                            </option>
                        }
                        
                    </InputSelect>
                </div>
                <label for="phoneNumber" class="form-label">Phone Number</label>
                <InputText id="phoneNumber" class="form-control phone-number-input" @bind-Value="supportMessage.PhoneNumber" />
                <ValidationMessage For="@(() => supportMessage.PhoneNumber)" />
            </div>

            <div class="mb-3">
                <label for="message-input" class="form-label">Message</label>
                <InputTextArea id="message-input" @bind-Value="supportMessage.Message" class="form-control message-text-area" rows="5" placeholder="Enter your message here..." />
                <ValidationMessage For="@(() => supportMessage.Message)" />
            </div>



            <div class="d-grid gap-2 mb-3">
                <button class="btn btn-primary" type="submit">Send message</button>
            </div>
        </EditForm>
    </div>
</div>

@code {

    private SupportMessage supportMessage = new SupportMessage();

    public  Task HandleSendMessage()
    {
        Console.WriteLine("Support message sent successfully!");
        return Task.CompletedTask;
    }

}
