@using lofi_frontend.Models
<div class="project-card">

    <h4>@Project.Name</h4>
    <h4>Start: @Project.StartDate.ToShortDateString() @Project.StartDate.ToShortTimeString()</h4>
    <h4>End: @Project.EndDate.ToShortDateString() @Project.EndDate.ToShortTimeString()</h4>
    @* <h4>@Project.Timers.ForEach(t => t.IsActive.ToString())</h4> *@
</div>

@code {
    [Parameter]
    public Project Project { get; set; } = default!;
}
