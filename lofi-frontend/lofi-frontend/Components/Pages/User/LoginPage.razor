@using Microsoft.AspNetCore.Components.WebAssembly.Http
@using lofi_frontend.Models
@page "/Login"

@rendermode InteractiveServer

@inject IHttpClientFactory clientFactory;
@inject NavigationManager NavigationManager;

<div class="login-layout">
<div class="container-fluid d-flex justify-content-center align-items-start bg-info min-vh-100">
    <div class="card p-4 shadow mt-5" style="width: 100%; max-width: 450px;">

        <h3 class="text-center h4 mb-4">Log in to your account</h3>

        <EditForm 
			EditContext="editContext" 
			OnValidSubmit="HandleSignIn" 
			FormName="Login Form">
            <DataAnnotationsValidator />

            <div class="mb-3">
                <label class="form-label">Username</label>
                <InputText @bind-Value="loginForm.Username" class="form-control" />
                <div class="text-danger small"><ValidationMessage For="@(() => loginForm.Username)" /></div>
            </div>

            <div class="mb-3">
                <label class="form-label">Password</label>
                <InputText @bind-Value="loginForm.Password" class="form-control" type="password" />
                <div class="text-danger small"><ValidationMessage For="@(() => loginForm.Password)" /></div>
            </div>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger p-2 small text-center mb-3" role="alert">
                    @errorMessage
                </div>
            }

            <div class="d-grid gap-2 mb-3">
                <button class="btn btn-primary" type="submit">Login</button>

                @* <button class="btn btn-outline-dark" type="button">
                    <img src="https://developers.google.com/identity/images/g-logo.png" alt="Google logo" style="width:16px; margin-right:8px; vertical-align:middle;" />
                    Login with Google
                    </button> *@
            </div>

            <hr />

            <div class="text-center">
                <p class="mb-2 text-muted small">Don't have an account?</p>
                <NavLink href="Signup" class="btn btn-outline-secondary w-100">
                    Create an account
                </NavLink>
            </div>

        </EditForm>
    </div>
</div>
</div>
@code {
	public HttpClient httpClient { get; set; } = new();

	public LoginForm loginForm { get; set; } = new();
	public LoginRequest loginRequest { get; set; } = new();

	public EditContext? editContext { get; set; }

	private string? errorMessage;

	protected override void OnInitialized()
	{
		editContext = new EditContext(loginForm);
		httpClient = clientFactory.CreateClient("BackendApi");
	}

	private async Task HandleSignIn()
	{
		Console.WriteLine("Attempting to log in user");
		try
		{
			await GetUserInfo();
			await AuthenticateUser();
		}
		catch (Exception ex)
		{
			Console.WriteLine(ex.Message);
			errorMessage = "User account not found";
		}
	}

	private async Task GetUserInfo()
	{
		Console.WriteLine("Getting user data from backend");
		var userInfoRequest = new HttpRequestMessage(HttpMethod.Get, 
			httpClient.BaseAddress + "users/all");
		Console.WriteLine(userInfoRequest.RequestUri);
		Console.WriteLine(userInfoRequest.Method);

		var responseForUserData = await httpClient.SendAsync(userInfoRequest);
		Console.WriteLine(await responseForUserData.Content.ReadAsStringAsync());

		if (!responseForUserData.IsSuccessStatusCode) throw new FileNotFoundException();

		var userList = await responseForUserData.Content.ReadFromJsonAsync<List<UserData>>();
		UserData? userInfo = userList?.FirstOrDefault(u => u.Username == loginForm.Username);

		if (userInfo == null) throw new InvalidDataException("No user found");

		Console.WriteLine($"User Details: {userInfo?.Username}");

		loginRequest.Email = userInfo.Email;
		loginRequest.Password = loginForm.Password;
	}

	private async Task AuthenticateUser()
	{
		errorMessage = null;
		Console.WriteLine("Attempting to sign in user: " + loginForm?.Username);
		try
		{
			Console.WriteLine("Creating request");
			var request = new HttpRequestMessage(HttpMethod.Post, "auth/sign-in")
            {
                Content = JsonContent.Create(
					loginRequest
				)
            };

			Console.WriteLine("Sending authentication request to:" + request.RequestUri);
			request.SetBrowserRequestCredentials(BrowserRequestCredentials.Include);

			var responseForAuth = await httpClient.SendAsync(request);
			if(!responseForAuth.IsSuccessStatusCode)
			{
				Console.WriteLine($"Request failed: {await responseForAuth.Content.ReadAsStringAsync()}");
				errorMessage = "Invalid Username or password";
				return;
			}

			Console.WriteLine(await responseForAuth.Content.ReadAsStringAsync());
			NavigationManager.NavigateTo($"/Dashboard");
		}
		catch (Exception ex)
		{
			errorMessage = "An error occurred while trying to authenticate. Please try again later.";
			Console.WriteLine($"Error during authentication: {ex.Message} | \n {ex.StackTrace}");
			return;
		}
	}

	public class LoginForm
	{
		public string Username { get; set; } = "";
		public string Password { get; set; } = "";
	}

	public class LoginRequest(string email = "", string password = "")
	{
		public string Email { get; set; } = email;
		public string Password { get; set; } = password;
	}
}
