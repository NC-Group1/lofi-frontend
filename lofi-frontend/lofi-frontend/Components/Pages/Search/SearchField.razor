@using lofi_frontend.Models
@inject HttpClient Http

<div class="d-flex flex-row justify-content-around align-content-center gap-3 h-100">

<InputText
    class="input-group-text w-100"
    type="text"
    @bind-value="searchBox"
    placeholder="Find a new mood..." />

<button class="btn btn-dark display-6 w-50 h-100" type="button" @onclick="ReturnSearchTerm">Search</button>

</div>
@code {
    private string searchBox = "";
    private List<Music>? youtubeVideos;
    private string? errorMessage;

    [Parameter] public EventCallback<string> GetSearchTerm { get; set; }

    private async Task ReturnSearchTerm()
    {
        if (this.GetSearchTerm.HasDelegate)
        {
            await this.GetSearchTerm.InvokeAsync(this.searchBox);
        }

    }

