@using lofi_frontend.Models
@inject HttpClient Http

<div class="d-flex flex-column justify-content-center align-items-center gap-3">
<h3>Search Field</h3>

<input class="input-group-text"
	   @bind-value="searchBox"
	   @bind-value:event="oninput"
	   placeholder="Search..." />

<button class="btn btn-dark" type="button" @onclick="ReturnSearchTerm">Search</button>

</div>
@code {
    private string searchBox = "Focus";
    private List<Music>? youtubeVideos;
    private string? errorMessage;

    [Parameter] public EventCallback<string> GetSearchTerm { get; set; }

    private async Task ReturnSearchTerm()
    {
        if (this.GetSearchTerm.HasDelegate)
        {
            await this.GetSearchTerm.InvokeAsync(this.searchBox);
        }

    }


