@using lofi_frontend.Models
@using lofi_frontend.Components.MusicPlayer
@using lofi_frontend.Components.Layout

<div class="d-flex flex-row flex-wrap gap-4 justify-content-center align-content-center">
	@if (YoutubeVideos == null || YoutubeVideos.Count() <= 0)
	{
		<p>No videos found...</p>
	}
	else
	{
		@foreach (var youtube in YoutubeVideos)
		{
			<div class="hello">
				<SearchResult YoutubeVideo="youtube" GetVideoCode="GetVideoCode"/>
			</div>
		}
	}
</div>

@code {
	[Parameter]
	public List<Music>? YoutubeVideos { get; set; } = [];

	[Parameter]
	public EventCallback<string> GetVideoCode { get; set; }
}
