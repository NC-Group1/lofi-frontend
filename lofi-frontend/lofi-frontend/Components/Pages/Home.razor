@page "/"
@using lofi_frontend.Components.MusicPlayer
@using lofi_frontend.Components.Pages.Search
@using lofi_frontend.Models

@inject IHttpClientFactory clientFactory;

@rendermode InteractiveServer

<PageTitle>Home</PageTitle>
<div class="home-page page-container">
	<div class="home-layout">
		<div class="d-flex flex-column gap-5">
			@* <div class="welcome-message">
			<h2>Welcome to Calico ☕</h2>
			<p>
				Focus, relax and track your projects
				with curated lo-fi playlists.
			</p>
		</div>
		<div class="now-playing home-card">
			<h3>🎵 Now Playing</h3>
		</div> *@
			<MusicPlayerComponent @ref="MusicPlayerRef" VideoCode="@VideoCode" GetSearchTerm="GetSearchTerm" />
		</div>
		<div class="container featured-moods-section home-card">
			<h3>Results</h3>

			<SearchComponentList @ref="SearchResultRef" YoutubeVideos="YoutubeVideos" />

			@* <FeaturedMoodsComponent /> *@
		</div>
	</div>
</div>

@code {
	private string VideoCode = "ZvJQt559CTY";
	private string SearchTerm { get; set; } = "";
	private string? errorMessage { get; set; }
	private List<Music>? YoutubeVideos { get; set; }

	private HttpClient httpClient { get; set; } = new();

	private MusicPlayerComponent? MusicPlayerRef { get; set; }
	private SearchComponentList? SearchResultRef { get; set; }

	protected override void OnInitialized()
	{
		clientFactory.CreateClient("BackendApi");
	}

	private async Task GetSearchTerm(string searchTerm)
	{
		Console.WriteLine("Getting Search");
		SearchTerm = searchTerm;
		Console.WriteLine($"Search: {searchTerm}");
		Console.WriteLine("Searching for videos");
		await GetVideo();
	}

	private async Task GetVideo()
	{
		Console.WriteLine("attempting to search for videos");
		try
		{
			errorMessage = null;
			Console.WriteLine("Creating request");

			var request = new HttpRequestMessage(
				HttpMethod.Get, " https://localhost:7245/Youtube" + $"?search={SearchTerm}"
			);

			Console.WriteLine($"Request Info: URL {request.RequestUri}");

			var response = await httpClient.SendAsync(request);

			Console.WriteLine(await response.Content.ReadAsStringAsync());

			YoutubeVideos = await response.Content.ReadFromJsonAsync<List<Music>>();

		}
        catch (Exception ex)
        {
            errorMessage = $"Could not load videos: {ex.Message}";
            YoutubeVideos = new List<Music>();
        }
    }
}