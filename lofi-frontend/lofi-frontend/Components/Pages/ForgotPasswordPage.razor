@page "/forgot-password"
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.WebUtilities
@rendermode InteractiveServer
@inject HttpClient HttpClient;


<div class="forgot-password-container">
    <div class="forgot-password-card">

        <h1 class="heading-subtitle" >Don't worry, it happens to the best of us!</h1>
        <h2 class="heading-title">Reset your Password ✨</h2>

        @if (!string.IsNullOrEmpty(infoMessage))
        {
            <div class="alert alert-success">
                @infoMessage
            </div>
        }

        <EditForm EditContext="editContext"
                  OnValidSubmit="HandleResetLink" FormName="ForgotPasswordForm">
            <DataAnnotationsValidator />

            <div class="password-form-group">
                <label for="password_to_reset" class="password-form-label">
                    Email Address <span class="required-asterisk">*</span>
                </label>
                <InputText @bind-Value="email" id="email_to_reset" class="password-form-control" type="email" placeholder="Enter your email address" />
                <div class="validation-error"><ValidationMessage For="@(() => email)" /></div>
            </div>

            <div class="password-form-actions">
                <button type="submit" class="btn btn-primary"  id="reset_link_btn">Send Reset Link</button>
            </div>

            <div class="password-form-footer">
                Have an account? <a class="login-link" href="/login">Sign In</a>
            </div>
        </EditForm>

    </div>
</div>

@code {
    private string infoMessage = string.Empty;
    private ResetPasswordForm ResetPasswordModel = new ResetPasswordForm();
    private string email = string.Empty;
    private EditContext editContext;

    protected override void OnInitialized()
    {
        editContext = new EditContext(email);
    }

    private async Task HandleResetLink()
    {

        var uri = "https://localhost:7245/Auth";

        try
        {

            Console.WriteLine($"Sending password reset request for email: {email}");
            var response = await HttpClient.PostAsJsonAsync(uri, email);
            if (response.IsSuccessStatusCode)
            {
                infoMessage = "Your password reset request has been processed successfully.";
                return;
            }
            else
            {

                Console.WriteLine($"Error response from server: {response.StatusCode} - {response.ReasonPhrase}");
                infoMessage = "An error occurred while processing your password reset request.";
                return;
            }
        }
        catch (Exception ex)
        {

            Console.WriteLine($"Error sending password reset request: {ex.Message}");
            infoMessage = $"An error occurred: {ex.Message}";
            return;
        }


        // var uri = "https:localhost:7245/Users";
        // var data = new Dictionary<string, string>
        // {
        //     { "email", ResetPasswordModel?.Email ?? "Invalid Email" }
        // };

        // string requestUri = QueryHelpers.AddQueryString(uri, data);

        // try
        // {
        //     var response = await HttpClient.GetAsync(requestUri);
        //     if(response.IsSuccessStatusCode)
        //     {
        //         infoMessage = "Your password reset request has been processed successfully.";
        //         return;

        //     }
        // }
        // catch (Exception ex)
        // {
        //     infoMessage = $"An error occurred: {ex.Message}";
        //     return;
        // }


    }

    public class ResetPasswordForm
    {
        [Required(ErrorMessage = "Email address is required.")]
        [EmailAddress(ErrorMessage = "Invalid email address.")]
        public string Email { get; set; } = string.Empty;
    }
}